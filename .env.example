# -------------------------------------------------------------
# College ERP - Production Environment Variables Example
# -------------------------------------------------------------

# Render / Production PostgreSQL Connection String
# Example format: postgresql://username:password@dpg-xxxxxx-a.oregon-postgres.render.com:5432/college_erp_db
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Port Configuration (Render automatically sets PORT in production)
PORT=3000
NODE_ENV=production

# Optional: Google Gemini AI API Key (for ERP Assistant)
GEMINI_API_KEY=

# -------------------------------------------------------------
# Fallback / Alternative Cloud SQL / Local PostgreSQL variables
# (Used only if DATABASE_URL is not provided)
# -------------------------------------------------------------
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=college_erp
SQL_USER=postgres
SQL_PASSWORD=
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

